# 飞牛OS 部署配置（docker-compose 默认用这个）
# 端口选择：避开飞牛OS WebUI 占用的 80 端口
# 宿主端口：web 10001、server 10002（容器内端口还是 3001/80）

# 运行模式
NODE_ENV=production

# Server 监听（容器内）
PORT=3001
HOST=0.0.0.0

# Web 来源（CORS）：容器内 web 是 80 端口（nginx），但用户从宿主 10001 访问
# 注：容器间通信用 service name，server 看的是请求来源是 web 容器，不是宿主 10001
# 但浏览器 fetch 时 Origin header 是宿主 URL，所以这里写宿主端口
WEB_ORIGIN=http://localhost:10001

# 资源限制
SERVER_MEMORY_LIMIT=1G
WEB_MEMORY_LIMIT=256M
